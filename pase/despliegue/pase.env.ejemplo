# Configuración del conector del Pase. Archivo real: /etc/pase/pase.env (root:pase, 640).
# Nunca subir este archivo con valores al repositorio ni pegarlo en un chat.

# ePayco (dashboard.epayco.com › Configuración › Personalizaciones › Llaves secretas). Las mismas llaves sirven en pruebas y en
# producción: con EPAYCO_ENTORNO=sandbox todo va con test=TRUE.
EPAYCO_ENTORNO=sandbox
EPAYCO_CLIENTE=
EPAYCO_P_KEY=
EPAYCO_LLAVE_PUBLICA=
EPAYCO_LLAVE_PRIVADA=

PASE_URL_PUBLICA=https://__DOMINIO__
PASE_PUERTO=__PUERTO__
PASE_HOST=127.0.0.1
PASE_BASE_DATOS=/var/lib/pase/pase.db
PASE_PRECIO_CENTAVOS=2900000
PASE_REINTENTOS_DIAS=0,3,7
PASE_AVISOS_CORREO=
# Cadenas largas al azar: openssl rand -hex 32
PASE_SECRETO_SESION=
PASE_ADMIN_TOKEN=

# Correo de los avisos (Brevo › SMTP & API › SMTP). DigitalOcean solo deja salir por 2525.
# Autorizar la IP del droplet en Brevo › Seguridad › IP autorizadas. Sin PASE_SMTP_HOST los
# avisos quedan guardados en la tabla avisos y no se envían.
# PASE_SMTP_HOST=smtp-relay.brevo.com
PASE_SMTP_HOST=
PASE_SMTP_PUERTO=2525
PASE_SMTP_USUARIO=
PASE_SMTP_CLAVE=
PASE_CORREO_REMITENTE="Aula Virtual Empresarial <no-responder@edunest.co>"

# Moodle: simulado hasta crear las cohortes y el usuario conector-pase
PASE_MOODLE_SIMULADO=1
PASE_MOODLE_URL=https://portal.edunest.co
PASE_MOODLE_TOKEN=

# Producción: solo cuando David lo decida
# PASE_PERMITIR_PRODUCCION=1
